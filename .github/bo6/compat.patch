diff --git a/OptiScaler/misc/SwitchFlags.h b/OptiScaler/misc/SwitchFlags.h
new file mode 100644
index 0000000..c2cc5a2
--- /dev/null
+++ b/OptiScaler/misc/SwitchFlags.h
@@ -0,0 +1,60 @@
+#pragma once
+
+// Diagnostic switch file support.
+//
+// A plain text file named "optswitch.txt" next to the proxy DLL holds one token
+// per line (or space separated). Each token disables one group of OptiScaler
+// behaviour, so a single build can bisect which group breaks a specific game
+// without rebuilding. No token = stock behaviour.
+//
+// This exists only for the BO6 compatibility investigation and is meant to be
+// removed once the real cause is fixed.
+
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <unordered_set>
+
+namespace SwitchFlags
+{
+    inline const std::unordered_set<std::string>& Flags()
+    {
+        static const std::unordered_set<std::string> flags = []()
+        {
+            std::unordered_set<std::string> result;
+
+            wchar_t modulePath[MAX_PATH] {};
+            HMODULE self = nullptr;
+            if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                       GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   reinterpret_cast<LPCWSTR>(&Flags), &self) == 0 ||
+                self == nullptr)
+            {
+                return result;
+            }
+
+            if (GetModuleFileNameW(self, modulePath, MAX_PATH) == 0)
+                return result;
+
+            std::filesystem::path switchPath(modulePath);
+            switchPath.replace_filename(L"optswitch.txt");
+
+            std::ifstream in(switchPath);
+            std::string token;
+            while (in >> token)
+            {
+                if (!token.empty() && token[0] != '#')
+                    result.insert(token);
+            }
+
+            return result;
+        }();
+
+        return flags;
+    }
+
+    inline bool On(const char* name)
+    {
+        return Flags().count(name) > 0;
+    }
+}
