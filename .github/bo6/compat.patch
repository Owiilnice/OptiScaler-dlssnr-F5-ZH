--- a/OptiScaler/dllmain.cpp
+++ b/OptiScaler/dllmain.cpp
@@ -48,6 +48,15 @@
 
 #include <cwctype>
 #include <magic_enum.hpp>
+
+// Diagnostic kill switches, read once from the environment so a single build can
+// test several hypotheses without rebuilding. Any value other than "1" keeps the
+// stock behaviour.
+static bool EnvSwitchOn(const wchar_t* name)
+{
+    wchar_t buf[8] {};
+    return GetEnvironmentVariableW(name, buf, 8) > 0 && buf[0] == L'1';
+}
 #include <version_check.h>
 #include <misc/IdentifyGpu.h>
 #include <sha1/sha1.hpp>
