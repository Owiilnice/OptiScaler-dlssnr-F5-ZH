+    // GDI32 / Wintrust / Crypt32 / Advapi32
+    if (EnvSwitchOn(L"OPTI_NO_EXTRAHOOKS"))
+    {
+        spdlog::warn("Gdi32/Wintrust/Crypt32/Advapi32 hooks skipped (OPTI_NO_EXTRAHOOKS=1)");
+    }
+    else
+    {
+        // GDI32
+        hookGdi32();
 
-    // Wintrust
-    hookWintrust();
+        // Wintrust
+        hookWintrust();
 
-    // Crypt32
-    hookCrypt32();
+        // Crypt32
+        hookCrypt32();
 
-    // Advapi32
-    if (Config::Instance()->DxgiSpoofing.value_or_default() ||
-        Config::Instance()->StreamlineSpoofing.value_or_default())
-    {
-        hookAdvapi32();
+        // Advapi32
